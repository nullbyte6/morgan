QWidget#root {
    background-color: #24273a;
    color: #cad3f5;
}

QLabel#hero {
    color: #cad3f5;
    background: transparent;
    font-size: 18px;
    font-weight: 600;
}

QLabel#muted,
QLabel#status {
    color: #a5adcb;
    font-size: 16px;
}

QLabel#subtitles {
    color: #cad3f5;
    background: transparent;
    font-size: 16px;
    font-weight: 200;
}


QFrame#inputFrame {
    background: transparent;
    border: 1px solid #494d64;
    border-radius: 24px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 16px;
    selection-background-color: #494d64;
}

QPushButton#send {
    background-color: #8aadf4;
    color: #24273a;
    border: none;
    border-radius: 24px;
    font-size: 18px;
    font-weight: 600;
}

QPushButton#send:hover {
    background-color: #b7bdf8;
}

QPushButton#send:pressed {
    background-color: #7dc4e4;
}

QPushButton#send:disabled {
    background-color: #494d64;
    color: #a5adcb;
}

ToggleSwitch {
    qproperty-trackOff: #24273a;
    qproperty-trackOn: #8aadf4;
    qproperty-thumbColor: #cad3f5;
}

QWidget#windowContainer {
    background-color: #24273a;
}

QStackedWidget#mainPages {
    background-color: #24273a;
    border: none;
}

QPushButton#chatNav,
QPushButton#logsNav {
    background-color: transparent;
    color: #a5adcb;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 22px;
}

QPushButton#chatNav:hover,
QPushButton#logsNav:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#chatNav:checked,
QPushButton#logsNav:checked {
    background-color: #494d64;
    color: #cad3f5;
    border: 1px solid #8aadf4;
}

QLabel#logTitle {
    color: #cad3f5;
    font-size: 16px;
    font-weight: 600;
}

QTextEdit#logViewer {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 12px;
    padding: 12px;
}


