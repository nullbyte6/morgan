    margin: 0;
}

QScrollArea#browserExtensionsScroll QScrollBar::handle:vertical {
    background: @scrollbar;
    border-radius: 4px;
    min-height: 24px;
}

QScrollArea#browserExtensionsScroll QScrollBar::add-line:vertical,
QScrollArea#browserExtensionsScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#browserExtensionsScroll QScrollBar::add-page:vertical,
QScrollArea#browserExtensionsScroll QScrollBar::sub-page:vertical {
    background: transparent;
}
