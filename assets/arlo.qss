QFrame#commandPalette {
    background-color: #24273a;
    border: 2px solid #494d64;
    border-radius: 16px;
}

QPlainTextEdit#commandPaletteSearch {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 16px;
}

QListWidget#commandPaletteResults {
    background: transparent;
    color: #cad3f5;
    border: none;
    outline: none;
    font-size: 15px;
}

QListWidget#commandPaletteResults::item {
    padding: 8px 10px;
    border-radius: 8px;
}

QListWidget#commandPaletteResults::item:selected {
    background-color: #494d64;
    color: #cad3f5;
}

QListWidget#commandPaletteResults::item:disabled,
QLabel#commandPaletteEmpty {
    color: #a5adcb;
    background: transparent;
}

QListWidget#commandPaletteResults QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0;
}

QListWidget#commandPaletteResults QScrollBar::handle:vertical {
    background-color: #6e738d;
    border-radius: 3px;
    min-height: 24px;
}

QListWidget#commandPaletteResults QScrollBar::add-line:vertical,
QListWidget#commandPaletteResults QScrollBar::sub-line:vertical {
    height: 0;
}

QListWidget#commandPaletteResults QScrollBar::add-page:vertical,
QListWidget#commandPaletteResults QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#root,
QWidget#settingsPage {
    background-color: transparent;
    color: #cad3f5;
}

QLabel#muted,
QLabel#status,
QLabel#activityTrail,
QLabel#subtitles {
    background: transparent;
    color: #cad3f5;
    font-size: 16px;
}

QLabel#activityTrail {
    color: #a5adcb;
    font-size: 14px;
}


QToolTip {
    background-color: #24273a;
    color: #cad3f5;
    border: 2px solid #494d64;
    padding: 2px 6px;
    font-family: "Inter";
    font-size: 16px;
}

QWidget#mascotSubtitleBubble {
    background-color: #24273a;
    border: 2px solid #494d64;
    border-radius: 24px;
    color: #cad3f5;
    font-size: 16px;
}

QFrame#inputFrame {
    background: transparent;
    border: 2px solid #494d64;
    border-radius: 24px;
}

QLabel#responseTimer {
    background-color: transparent;
    color: #cad3f5;
    border: 2px solid #494d64;
    border-radius: 17px;
    padding: 6px 12px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 16px;
    selection-background-color: #494d64;
}

QPushButton#attach,
QPushButton#send {
    border-radius: 24px;
}

QPushButton#send {
    background-color: #8aadf4;
    color: #24273a;
    border: 2px solid #494d64;
}

QPushButton#attach {
    background-color: transparent;
    border: none;
    color: #cad3f5;
}

QPushButton#send:hover {
    background-color: #b7bdf8;
    color: #494d64;
}

QPushButton#attach:hover {
    background-color: transparent;
    color: #b7bdf8;
}

QPushButton#send:pressed {
    background-color: #8aadf4;
    color: #494d64;
}

QPushButton#attach:pressed {
    background-color: transparent;
    color: #8aadf4;
}

QPushButton#send:disabled {
    background-color: #494d64;
    color: #cad3f5;
}

QPushButton#attach:disabled {
    background-color: transparent;
    color: #494d64;
}

ToggleSwitch {
    qproperty-trackOff: #494d64;
    qproperty-trackOn: #8aadf4;
    qproperty-thumbColor: #cad3f5;
}

QMainWindow#assistantWindow,
QGraphicsView#globalZoomView,
QWidget#globalZoomViewport,
QWidget#windowContainer {
    background-color: transparent;
}

QPushButton#settingsNav,
QPushButton#chatNav,
QPushButton#logsNav,
QPushButton#editorNav,
QPushButton#terminalNav,
QPushButton#browserNav {
    background-color: transparent;
    color: #a5adcb;
    border: 2px solid transparent;
    border-radius: 10px;
    font-size: 32px;
}

QPushButton#logCopyNav {
    background-color: transparent;
    color: #a5adcb;
    border: 2px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    padding: 0;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QPushButton#settingsNav:hover,
QPushButton#chatNav:hover,
QPushButton#logsNav:hover,
QPushButton#editorNav:hover,
QPushButton#terminalNav:hover,
QPushButton#browserNav:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#logCopyNav:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QToolButton#directory {
    background-color: transparent;
    border: 2px solid #494d64;
    border-radius: 16px;
    color: #cad3f5;
    padding: 4px;
}

QToolButton#directory:hover,
QToolButton#directory:pressed {
    border: 2px solid #8aadf4;
}

QComboBox#modelSelector {
    combobox-popup: 0;
    background-color: transparent;
    border: 2px solid #494d64;
    border-radius: 16px;
    color: #cad3f5;
    padding: 5px 26px 5px 10px;
}

QComboBox#modelSelector:hover,
QComboBox#modelSelector:on {
    border: 2px solid #8aadf4;
}

QLabel#logTitle {
    color: #cad3f5;
    font-size: 24px;
    padding-left: 16px;
}

QComboBox#languageDropdown,
QComboBox#modelDropdown {
    combobox-popup: 0;
    background-color: #24273a;
    color: #cad3f5;
    border: 2px solid #494d64;
    border-radius: 8px;
    padding: 10px 32px 10px 16px;
    font-size: 16px;
}

QComboBox#languageDropdown:hover,
QComboBox#modelDropdown:hover,
QComboBox#languageDropdown:focus,
QComboBox#modelDropdown:focus {
    border-color: #8aadf4;
}

QComboBox#languageDropdown::drop-down,
QComboBox#modelDropdown::drop-down,
QComboBox#modelSelector::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0;
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView,
QComboBox#modelDropdown QAbstractItemView,
QComboBox#modelSelector QAbstractItemView {
    background-color: #24273a;
    color: #cad3f5;
    border: 2px solid #494d64;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
    padding: 6px;
    outline: none;
}

QComboBox#languageDropdown QAbstractItemView::item,
QComboBox#modelDropdown QAbstractItemView::item,
QComboBox#modelSelector QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 24px;
}

QComboBox#languageDropdown QAbstractItemView::item:hover,
QComboBox#modelDropdown QAbstractItemView::item:hover,
QComboBox#modelSelector QAbstractItemView::item:hover,
QComboBox#languageDropdown QAbstractItemView::item:selected,
QComboBox#modelDropdown QAbstractItemView::item:selected,
QComboBox#modelSelector QAbstractItemView::item:selected {
    background-color: #494d64;
    color: #cad3f5;
}

QScrollArea#chatScroll,
QScrollArea#logScroll {
    background: transparent;
    border: none;
}

QScrollArea#chatScroll QScrollBar:vertical,
QScrollArea#logScroll QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollArea#chatScroll QScrollBar:horizontal,
QScrollArea#logScroll QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QWidget#attachmentTray {
    background: transparent;
    border: none;
}

QFrame#attachmentChip {
    background-color: transparent;
    border: 2px solid #494d64;
    border-radius: 12px;
}

QFrame#attachmentChip:hover {
    background-color: #3c4057;
    border-color: #6e738d;
}

QFrame#attachmentChip QLabel {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 13px;
}

QFrame#attachmentChip QLabel#attachmentDetail {
    font-size: 11px;
}

QPushButton#removeAttachment {
    background: transparent;
    color: #cad3f5;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
}

QPushButton#removeAttachment:hover,
QPushButton#removeAttachment:pressed {
    background-color: #363a4f;
    color: #cad3f5;
}

QWidget#editorPage {
    background-color: #24273a;
    color: #cad3f5;
}

QPlainTextEdit#codeEditor,
QPlainTextEdit#diffWorkspaceEditor {
    background-color: #1e2030;
    color: #cad3f5;
    border: none;
    border-radius: 10px;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
}

QPlainTextEdit#codeEditor QScrollBar:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar:vertical {
    background-color: #1e2030;
    width: 12px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:vertical {
    background-color: #494d64;
    border-radius: 4px;
    min-height: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical:hover,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:vertical:hover {
    background-color: #6e738d;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-line:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-line:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-page:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-page:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-page:vertical {
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar:horizontal {
    background-color: #1e2030;
    height: 10px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:horizontal {
    background-color: #494d64;
    border-radius: 5px;
    min-width: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal:hover,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:horizontal:hover {
    background-color: #6e738d;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-line:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-line:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-page:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-page:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-page:horizontal {
    background: transparent;
}

QWidget#editorPage QPushButton,
QWidget#terminalPage QPushButton {
    background-color: #363a4f;
    color: #cad3f5;
    border: 2px solid #494d64;
    border-radius: 9px;
    padding: 8px 16px;
}

QWidget#editorPage QPushButton:hover,
QWidget#terminalPage QPushButton:hover {
    background-color: #494d64;
    border-color: #8aadf4;
}

QWidget#editorPage QPushButton:pressed,
QWidget#terminalPage QPushButton:pressed {
    background-color: #8aadf4;
    color: #24273a;
}

QWidget#editorPage QPushButton:disabled,
QWidget#terminalPage QPushButton:disabled {
    background-color: #363a4f;
    color: #6e738d;
    border-color: #494d64;
}

QPlainTextEdit#terminalOutput {
    background-color: transparent;
    color: #cad3f5;
    border: none;
    selection-background-color: #494d64;
}

QLabel#terminalStatus {
    color: #a5adcb;
    background: transparent;
}

QFileDialog,
QMessageBox {
    background-color: #24273a;
    color: #cad3f5;
}

QMessageBox QLabel {
    color: #cad3f5;
    background: transparent;
}

#assistantWorkspace {
    background-color: transparent;
}

#workspacePanel {
    background-color: #24273a;
    border: 2px solid #494d64;
    border-radius: 12px;
}

#workspacePanel[active="true"] {
    border: 2px solid #8aadf4;
}

#workspacePanelHeader {
    background: transparent;
    border: none;
}

#workspacePanelTitle {
    color: #cad3f5;
    font-size: 16px;
    border: none;
}

#workspacePanelClose {
    color: #cad3f5;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 16px;
}

#workspacePanelClose:hover {
    background-color: transparent;
    color: #ed8796;
}

#workspacePanelContent,
#workspacePlaceholder {
    background: transparent;
    border: none;
}

#workspacePlaceholderLabel {
    color: #8087a2;
    font-size: 13px;
    border: none;
}

#desktopFileDropIndicator {
    background-color: rgba(36, 39, 58, 210);
    border: 2px solid #8aadf4;
    border-radius: 10px;
}

#desktopFileDropIndicator[valid="false"] {
    border-color: #8087a2;
}

#desktopFileDropIndicator QLabel {
    color: #cad3f5;
    background: transparent;
    border: none;
    font-size: 13px;
}

#workspaceFileViewer,
#fileViewerSource,
#fileViewerSource QAbstractScrollArea:viewport {
    color: #cad3f5;
    background-color: #24273a;
    border: none;
    selection-background-color: #494d64;
}

#fileViewerStatus,
#diffWorkspaceDirectory {
    color: #a5adcb;
    border: none;
    font-size: 12px;
}

#workspaceFileViewer QPushButton,
#workspaceFileViewer QSpinBox,
#workspaceFileViewer QLineEdit {
    color: #cad3f5;
    background-color: #363a4f;
    border: 1px solid #494d64;
    border-radius: 6px;
    padding: 3px 6px;
    min-width: 0;
}

#workspaceFileViewer QPushButton:hover {
    border-color: #8aadf4;
}

#responseView,
#responseDocument,
#responseDocument QAbstractScrollArea:viewport {
    color: #cad3f5;
    background-color: #24273a;
    border: none;
}

#responseDocument QScrollBar:vertical,
#responseDocument QScrollBar:horizontal {
    background: #24273a;
    border: none;
}

QSplitter#workspaceSplitter::handle {
    background-color: transparent;
}

QSplitter#workspaceSplitter::handle:hover {
    background-color: #8aadf4;
}

QPushButton#privacyIndicator {
    color: #86EFAC;
    background-color: rgba(34, 197, 94, 0.08);
    border: 2px solid #466d62;
    border-radius: 14px;
    padding: 4px 10px;
}

QToolButton#branchIndicator {
    color: #a6da95;
    background-color: rgba(166, 218, 149, 0.08);
    border: 2px solid #4b5d55;
    border-radius: 16px;
    padding: 4px 10px;
}

QPushButton#privacyIndicator:hover {
    background-color: rgba(34, 197, 94, 0.12);
    border-color: #5a957a;
}

QWidget#mainWorkspaceContent,
QWidget#taskProgressHost {
    background: transparent;
}

QFrame#taskProgressPill {
    background-color: #363a4f;
    border: 2px solid #494d64;
    border-radius: 24px;
    min-width: 0;
    max-width: 440px;
}

QLabel#taskProgressTitle {
    background: transparent;
    color: #cad3f5;
    border: none;
    font-size: 16px;
}

QLabel#taskProgressStep,
QLabel#taskProgressSubtitle {
    background: transparent;
    color: #b8c0e0;
    border: none;
    font-size: 16px;
}

QProgressBar#taskProgressBar {
    background-color: #24273a;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#taskProgressBar::chunk {
    background-color: #8aadf4;
    border-radius: 4px;
}

QProgressBar#taskProgressBar[state="finished"]::chunk {
    background-color: #a6da95;
}

QProgressBar#taskProgressBar[state="waiting"]::chunk,
QProgressBar#taskProgressBar[state="stopped"]::chunk {
    background-color: #eed49f;
}

QProgressBar#taskProgressBar[state="error"]::chunk {
    background-color: #ed8796;
}

QPushButton#taskProgressClose {
    background: transparent;
    color: #a5adcb;
    border: none;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    font-size: 20px;
}

QPushButton#taskProgressClose:hover,
QPushButton#taskProgressClose:focus {
    background-color: transparent;
    color: #cad3f5;
}

QPushButton#taskProgressClose:pressed {
    color: #ed8796;
}

QWidget#logContainer {
    background: transparent;
}

QFrame#logMessageCard {
    background-color: #1e2030;
    border: 2px solid #494d64;
    border-radius: 12px;
}

QFrame#logMessageCard[role="assistant"] {
    background-color: #292d40;
}

QFrame#logMessageCard[role="system"] {
    background-color: #363a4f;
    border-color: #6e738d;
}

QLabel#logMessageAuthor {
    color: #8aadf4;
    font-size: 16px;
    background: transparent;
    border: none;
}

QLabel#logMessageTime {
    color: #a5adcb;
    font-size: 16px;
    background: transparent;
    border: none;
}

QTextBrowser#logMessageBody {
    background: transparent;
    color: #cad3f5;
    border: none;
    padding: 0;
    font-size: 16px;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
}

QTextBrowser#logMessageBody QScrollBar {
    width: 0;
    height: 0;
}

QWidget#terminalPage {
    background-color: transparent;
}

QPlainTextEdit#terminalOutput QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical {
    background: #494d64;
    min-height: 24px;
    border-radius: 3px;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical:hover {
    background: #6e738d;
}

QPlainTextEdit#terminalOutput QScrollBar::add-line:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::add-page:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-page:vertical {
    background: transparent;
}

QMenu#terminalMenu {
    background-color: #24273a;
    color: #cad3f5;
    border: 2px solid #494d64;
    padding: 4px;
}

QMenu#terminalMenu::item {
    padding: 6px 18px;
}

QMenu#terminalMenu::item:selected {
    background-color: #494d64;
}

QMenu#terminalMenu::item:disabled {
    color: #6e738d;
}

QWidget#browserView {
    background-color: transparent;
    color: #cad3f5;
}

QWidget#browserView QPushButton,
QWidget#browserExtensionsPage QPushButton {
    background-color: #363a4f;
