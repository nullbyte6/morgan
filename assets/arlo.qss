QWidget#root,
QWidget#settingsPage {
    background-color: transparent;
    color: #cad3f5;
}

QLabel#hero {
    color: #cad3f5;
    background: transparent;
    font-size: 16px;
}

QLabel#muted,
QLabel#status,
QLabel#subtitles {
    background: transparent;
    color: #cad3f5;
    font-size: 16px;
}

QLabel#mascotSubtitleBubble {
    background-color: #24273a;
    border: 1px solid #494d64;
    border-radius: 24px;
    color: #cad3f5;
    font-size: 16px;
}

QFrame#inputFrame {
    background: transparent;
    border: 1px solid #494d64;
    border-radius: 24px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 16px;
    selection-background-color: #494d64;
}

QPushButton#attach,
QPushButton#send {
    background-color: #8aadf4;
    color: #24273a;
    border: 1px solid #494d64;
    border-radius: 24px;
}

QPushButton#attach {
    background-color: transparent;
    border: none;
    color: #cad3f5
}

QPushButton#send:hover {
    background-color: #b7bdf8;
    color: #494d64
}

QPushButton#attach:hover {
    background-color: transparent;
    color: #b7bdf8;
}

QPushButton#send:pressed {
    background-color: #8aadf4;
    color: #494d64
}

QPushButton#attach:pressed {
    background-color: transparent;
    color: #8aadf4;
}

QPushButton#send:disabled {
    background-color: #494d64;
    color: #cad3f5;
}

QPushButton#attach:disabled {
    background-color: transparent;
    color: #494d64;
}

ToggleSwitch {
    qproperty-trackOff: #494d64;
    qproperty-trackOn: #8aadf4;
    qproperty-thumbColor: #cad3f5;
}

QMainWindow#arloWindow,
QGraphicsView#globalZoomView,
QWidget#globalZoomViewport,
QWidget#windowContainer {
    background-color: transparent;
}

QPushButton#settingsNav,
QPushButton#chatNav,
QPushButton#logsNav,
QPushButton#editorNav,
QPushButton#terminalNav,
QPushButton#browserNav,
QPushButton#refresh {
    background-color: transparent;
    color: #a5adcb;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 32px;
}

QPushButton#settingsNav:hover,
QPushButton#chatNav:hover,
QPushButton#logsNav:hover,
QPushButton#editorNav:hover,
QPushButton#terminalNav:hover,
QPushButton#browserNav:hover,
QPushButton#refresh:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#settingsNav:checked,
QPushButton#chatNav:checked,
QPushButton#logsNav:checked,
QPushButton#editorNav:checked,
QPushButton#terminalNav:checked,
QPushButton#browserNav:checked,
QPushButton#refresh:checked {
    background-color: #494d64;
    color: #cad3f5;
    border: 1px solid #8aadf4;
}

QToolButton#directory {
    background-color: transparent;
    border: 1px solid #494d64;
    border-radius: 16px;
    color: #cad3f5;
    padding: 4px;
}

QToolButton#directory:hover,
QToolButton#directory:pressed {
    border: 1px solid #8aadf4;
}

QLabel#logTitle {
    color: #cad3f5;
    font-size: 24px;
    padding-left: 16px
}

QTextEdit#logViewer {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 12px;
    padding: 12px;
}

QComboBox#languageDropdown ,
QComboBox#modelDropdown {
    combobox-popup: 0;
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 8px;
    padding: 10px 32px 10px 16px;
    font-size: 16px;
}

QComboBox#languageDropdown:hover,
QComboBox#modelDropdown:hover,
QComboBox#languageDropdown:focus ,
QComboBox#modelDropdown:focus {
    border-color: #8aadf4;
}

QComboBox#languageDropdown::drop-down ,
QComboBox#modelDropdown::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0;
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView ,
QComboBox#modelDropdown QAbstractItemView {
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
    padding: 6px;
    outline: none;
}

QComboBox#languageDropdown QAbstractItemView::item ,
QComboBox#modelDropdown QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 24px;
}

QComboBox#languageDropdown QAbstractItemView::item:hover,
QComboBox#modelDropdown QAbstractItemView::item:hover,
QComboBox#languageDropdown QAbstractItemView::item:selected ,
QComboBox#modelDropdown QAbstractItemView::item:selected {
    background-color: #494d64;
    color: #cad3f5;
}

QScrollArea#chatScroll {
    background: transparent;
    border: none;
}

QScrollArea#chatScroll QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollArea#chatScroll QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QScrollArea#attachmentTray {
    background: transparent;
    border: none;
}

QScrollArea#attachmentTray > QWidget > QWidget {
    background: transparent;
    border: none;
}

QScrollArea#attachmentTray QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QScrollArea#attachmentTray QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QFrame#attachmentChip {
    background-color: transparent;
    border: 1px solid #494d64;
    border-radius: 12px;
}

QFrame#attachmentChip:hover {
    background-color: #3c4057;
    border-color: #6e738d;
}

QFrame#attachmentChip QLabel {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 13px;
}

QFrame#attachmentChip QLabel#attachmentDetail {
    color: #cad3f5;
    font-size: 11px;
}

QPushButton#removeAttachment {
    background: transparent;
    color: #cad3f5;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
}

QPushButton#removeAttachment:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#removeAttachment:pressed {
    background-color: #363a4f;
    color: #cad3f5;
}


QWidget#editorPage {
    background-color: #24273a;
    color: #cad3f5;
}

QTabWidget#editorTabs {
    background-color: transparent;
    border: none;
}

QTabWidget#editorTabs::pane {
    background-color: transparent;
    border: 0px;
    border-radius: 0px;
}

QTabWidget#editorTabs QTabBar {
    background-color: transparent;
}

QTabWidget#editorTabs QTabBar::tab {
    background-color: #363a4f;
    color: #a5adcb;

    border-bottom: none;

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;

    padding: 8px 16px;
    margin-right: 4px;

    min-width: 160px;
    font-size: 16px;
}


QTabWidget#editorTabs QTabBar::tab:hover {
    background-color: #494d64;
    color: #cad3f5;
}

QTabWidget#editorTabs QTabBar::tab:selected {
    background-color: #1e2030;
    color: #cad3f5;
    border-color: #494d64;
}

QTabWidget#editorTabs QTabBar::close-button {
    background: transparent;
    color: #cad3f5;
    border-radius: 4px;
    margin-left: 6px;
}

QTabWidget#editorTabs QTabBar::close-button:hover {
    color: #8aadf4;
}

QPlainTextEdit#codeEditor {
    background-color: #1e2030;
    color: #cad3f5;
    border: none;
    border-radius: 10px;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
}

QToolButton#editorTabClose {
    background-color: transparent;
    color: #cad3f5;
    border: none;
    border-radius: 4px;
    margin-right: 16px;
    font-size: 16px;
}

QToolButton#editorTabClose:hover,
QToolButton#editorTabClose:pressed {
    color: #F48AA5;
}

QPlainTextEdit#codeEditor QScrollBar:vertical {
    background-color: #1e2030;
    width: 12px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical {
    background-color: #494d64;
    border-radius: 4px;
    min-height: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical:hover {
    background-color: #6e738d;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-page:vertical {
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar:horizontal {
    background-color: #1e2030;
    height: 10px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal {
    background-color: #494d64;
    border-radius: 5px;
    min-width: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal:hover {
    background-color: #6e738d;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-page:horizontal {
    background: transparent;
}

QWidget#editorPage QPushButton,
QWidget#terminalPage QPushButton {
    background-color: #363a4f;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 9px;
    padding: 8px 16px;
}

QWidget#editorPage QPushButton:hover,
QWidget#terminalPage QPushButton:hover {
    background-color: #494d64;
    border-color: #8aadf4;
}

QWidget#editorPage QPushButton:pressed,
QWidget#terminalPage QPushButton:pressed {
    background-color: #8aadf4;
    color: #24273a;
}

QWidget#editorPage QPushButton:disabled,
QWidget#terminalPage QPushButton:disabled {
    background-color: #363a4f;
    color: #6e738d;
    border-color: #494d64;
}

QPlainTextEdit#terminalOutput {
    background-color: #181926;
    color: #cad3f5;
    border: none;
    selection-background-color: #494d64;
}

QLabel#terminalStatus {
    color: #a5adcb;
    background: transparent;
}

QLabel#editorStatus {
    background: transparent;
    color: #a5adcb;
    font-size: 16px;
    padding: 0 4px;
}

QFileDialog,
QMessageBox {
    background-color: #24273a;
    color: #cad3f5;
}

QMessageBox QLabel {
    color: #cad3f5;
    background: transparent;
}

#arloWorkspace {
    background-color: transparent;
}

#workspacePanel {
    background-color: #24273a;
    border: 2px solid #494d64;
    border-radius: 12px;
}

#workspacePanel[active="true"] {
    border: 2px solid #8aadf4;
}

#workspacePanelHeader {
    background: transparent;
    border: none;
}

#workspacePanelTitle {
    color: #cad3f5;
    font-size: 16px;
    border: none;
}

#workspacePanelClose {
    color: #cad3f5;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 16px;
}

#workspacePanelClose:hover {
    background-color: transparent;
    color: #ed8796;
}

#workspacePanelContent,
#workspacePlaceholder {
    background: transparent;
    border: none;
}

#workspacePlaceholderLabel {
    color: #8087a2;
    font-size: 13px;
    border: none;
}

QSplitter#workspaceSplitter::handle {
    background-color: transparent;
}

QSplitter#workspaceSplitter::handle:hover {
    background-color: #8aadf4;
}

QToolButton#privacyIndicator {
    color: #86EFAC;
    background-color: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(134, 239, 172, 0.35);
    border-radius: 14px;
    padding: 4px 10px;
}

QToolButton#privacyIndicator:hover {
    background-color: rgba(34, 197, 94, 0.12);
    border-color: rgba(134, 239, 172, 0.55);
}

QScrollArea#logScroll {
    background: transparent;
    border: none;
}

QWidget#taskProgressHost {
    background: transparent;
}

QFrame#taskProgressPill {
    background-color: #363a4f;
    border: 1px solid #494d64;
    border-radius: 24px;
    min-width: 360px;
    max-width: 440px;
}

QLabel#taskProgressTitle {
    background: transparent;
    color: #cad3f5;
    border: none;
    font-size: 14px;
    font-weight: 600;
}

QLabel#taskProgressStep {
    background: transparent;
    color: #b8c0e0;
    border: none;
    font-size: 12px;
}

QProgressBar#taskProgressBar {
    background-color: #24273a;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#taskProgressBar::chunk {
    background-color: #8aadf4;
    border-radius: 4px;
}

QProgressBar#taskProgressBar[state="finished"]::chunk {
    background-color: #a6da95;
}

QProgressBar#taskProgressBar[state="waiting"]::chunk,
QProgressBar#taskProgressBar[state="stopped"]::chunk {
    background-color: #eed49f;
}

QProgressBar#taskProgressBar[state="error"]::chunk {
    background-color: #ed8796;
}

QPushButton#taskProgressClose {
    background: transparent;
    color: #a5adcb;
    border: none;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    font-size: 20px;
}

QPushButton#taskProgressClose:hover,
QPushButton#taskProgressClose:focus {
    background-color: #494d64;
    color: #cad3f5;
}

QPushButton#taskProgressClose:pressed {
    background-color: #5b6078;
    color: #ed8796;
}

QScrollArea#logScroll QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollArea#logScroll QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QWidget#logContainer {
    background: transparent;
}

QFrame#logMessageCard {
    background-color: #1e2030;
    border: 1px solid #494d64;
    border-radius: 12px;
}

QFrame#logMessageCard[role="assistant"] {
    background-color: #292d40;
    border-color: #494d64;
}

QFrame#logMessageCard[role="user"] {
    background-color: #1e2030;
    border-color: #494d64;
}

QFrame#logMessageCard[role="system"] {
    background-color: #363a4f;
    border-color: #6e738d;
}

QLabel#logMessageAuthor {
    color: #8aadf4;
    font-size: 16px;
    background: transparent;
    border: none;
}

QLabel#logMessageTime {
    color: #a5adcb;
    font-size: 16px;
    background: transparent;
    border: none;
}

QTextBrowser#logMessageBody {
    background: transparent;
    color: #cad3f5;
    border: none;
    padding: 0;
    font-size: 16px;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
}

QTextBrowser#logMessageBody QScrollBar {
    width: 0;
    height: 0;
}

#workspacePanel[workspaceViewKey="terminal"] {
    background-color: #1e2030;
}

QWidget#terminalPage {
    background: transparent;
}

QPlainTextEdit#terminalOutput QScrollBar:vertical {
    background: #181926;
    width: 10px;
    margin: 2px;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical {
    background: #494d64;
    min-height: 24px;
    border-radius: 3px;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical:hover {
    background: #6e738d;
}

QPlainTextEdit#terminalOutput QScrollBar::add-line:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::add-page:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-page:vertical {
    background: transparent;
}

QMenu#terminalMenu {
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    padding: 4px;
}

QMenu#terminalMenu::item {
    padding: 6px 18px;
}

QMenu#terminalMenu::item:selected {
    background-color: #494d64;
}

QMenu#terminalMenu::item:disabled {
    color: #6e738d;
}

QWidget#browserView {
    background-color: transparent;
    color: #cad3f5;
}

QWidget#browserView QPushButton {
    background-color: #363a4f;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 10px;
    padding: 0;
    font-size: 24px;
}

QWidget#browserView QPushButton:hover,
QWidget#browserView QPushButton:focus {
    background-color: #494d64;
    border-color: #8aadf4;
}

QWidget#browserView QPushButton:pressed {
    background-color: #8aadf4;
    color: #24273a;
}

QWidget#browserView QPushButton:disabled {
    background-color: #363a4f;
    color: #6e738d;
    border-color: #494d64;
}

QLineEdit#browserAddressBar {
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 10px;
    padding: 0 12px;
    font-size: 16px;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
}

QLineEdit#browserAddressBar:hover,
QLineEdit#browserAddressBar:focus {
    border-color: #8aadf4;
}

QLineEdit#browserAddressBar:disabled {
    color: #6e738d;
}

QLabel#browserStatus,
QLabel#browserUnavailable {
    background: transparent;
    color: #a5adcb;
    border: none;
    font-size: 13px;
    padding: 0 4px;
}

QLabel#browserUnavailable {
    font-size: 16px;
}
