QWidget#root,
QWidget#settingsPage {
    background-color: #24273a;
    color: #cad3f5;
}

QLabel#hero {
    color: #cad3f5;
    background: transparent;
    font-size: 16px;
}

QLabel#muted,
QLabel#status,
QLabel#subtitles {
    background: transparent;
    color: #cad3f5;
    font-size: 16px;
}

QFrame#inputFrame {
    background: transparent;
    border: 1px solid #494d64;
    border-radius: 24px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 16px;
    selection-background-color: #494d64;
}

QPushButton#attach,
QPushButton#send {
    background-color: #8aadf4;
    color: #24273a;
    border: none;
    border-radius: 24px;
    font-size: 32px;
}

QPushButton#attach:hover,
QPushButton#send:hover {
    background-color: #b7bdf8;
}

QPushButton#attach:pressed,
QPushButton#send:pressed {
    background-color: #7dc4e4;
}

QPushButton#attach:disabled,
QPushButton#send:disabled {
    background-color: #494d64;
    color: #a5adcb;
}

ToggleSwitch {
    qproperty-trackOff: #24273a;
    qproperty-trackOn: #8aadf4;
    qproperty-thumbColor: #cad3f5;
}

QWidget#windowContainer {
    background-color: #24273a;
}

QStackedWidget#mainPages {
    background-color: #24273a;
    border: none;
}

QPushButton#settingsNav,
QPushButton#chatNav,
QPushButton#logsNav,
QPushButton#refresh {
    background-color: transparent;
    color: #a5adcb;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 32px;
}

QPushButton#settingsNav:hover,
QPushButton#chatNav:hover,
QPushButton#logsNav:hover,
QPushButton#refresh:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#settingsNav:checked,
QPushButton#chatNav:checked,
QPushButton#logsNav:checked,
QPushButton#refresh:checked {
    background-color: #494d64;
    color: #cad3f5;
    border: 1px solid #8aadf4;
}

QLabel#logTitle {
    color: #cad3f5;
    font-size: 24px;
    padding-left: 20px
}

QTextEdit#logViewer {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 12px;
    padding: 12px;
}

QComboBox#languageDropdown {
    combobox-popup: 0;
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 8px;
    padding: 10px 32px 10px 16px;
    font-size: 24px;
}

QComboBox#languageDropdown:hover,
QComboBox#languageDropdown:focus {
    border-color: #8aadf4;
}

QComboBox#languageDropdown::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0;
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView {
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
    padding: 6px;
    outline: none;
}

QComboBox#languageDropdown QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 24px;
}

QComboBox#languageDropdown QAbstractItemView::item:hover,
QComboBox#languageDropdown QAbstractItemView::item:selected {
    background-color: #494d64;
    color: #cad3f5;
}


QScrollArea#attachmentTray, QScrollArea#attachmentTray > QWidget > QWidget {
    background: transparent;
    border: none;
}
QScrollArea#chatScroll {
    background: transparent;
    border: none;
}
QScrollArea#chatScroll
QScrollBar:vertical {
    background: transparent;
    width: 16px;
    margin: 0;
}
QScrollArea#attachmentTray
QScrollBar:horizontal {
    background: #24273a;
    height: 8px;
    margin: 0;
}
QScrollArea#chatScroll
QScrollBar::handle,
QScrollArea#attachmentTray
QScrollBar::handle {
    background: transparent;
    border-radius: 4px;
    min-width: 24px;
    min-height: 16px;
}
QScrollArea#chatScroll
QScrollBar::add-line,
QScrollArea#chatScroll
QScrollBar::sub-line,
QScrollArea#attachmentTray
QScrollBar::add-line,
QScrollArea#attachmentTray
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollArea#chatScroll
QScrollBar::add-page,
QScrollArea#chatScroll
QScrollBar::sub-page,
QScrollArea#attachmentTray
QScrollBar::add-page,
QScrollArea#attachmentTray
 QScrollBar::sub-page {
    background: transparent;
}
QFrame#attachmentChip {
    background-color: #363a4f;
    border: 1px solid #494d64;
    border-radius: 12px;
}
QFrame#attachmentChip QLabel {
    color: #cad3f5;
    background: transparent;
}
QFrame#attachmentChip
QLabel#attachmentDetail {
    color: #a5adcb;
    font-size: 12px;
}
QPushButton#removeAttachment {
    background: transparent;
    color: #a5adcb;
    border: none;
    border-radius: 12px;
    font-size: 12px;
}
QPushButton#removeAttachment:hover {
    background-color: #494d64;
    color: #cad3f5;
}