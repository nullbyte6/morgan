QWidget#root,
QWidget#settingsPage {
    background-color: #24273a;
    color: #cad3f5;
}

QLabel#hero {
    color: #cad3f5;
    background: transparent;
    font-size: 18px;
    font-weight: 600;
}

QLabel#muted,
QLabel#status,
QLabel#subtitles {
    background: transparent;
    color: #cad3f5;
    font-size: 20px;
}

QFrame#inputFrame {
    background: transparent;
    border: 1px solid #494d64;
    border-radius: 24px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: #cad3f5;
    font-size: 20px;
    selection-background-color: #494d64;
}

QPushButton#send {
    background-color: #8aadf4;
    color: #24273a;
    border: none;
    border-radius: 24px;
    font-size: 20px;
    font-weight: 600;
}

QPushButton#send:hover {
    background-color: #b7bdf8;
}

QPushButton#send:pressed {
    background-color: #7dc4e4;
}

QPushButton#send:disabled {
    background-color: #494d64;
    color: #a5adcb;
}

ToggleSwitch {
    qproperty-trackOff: #24273a;
    qproperty-trackOn: #8aadf4;
    qproperty-thumbColor: #cad3f5;
}

QWidget#windowContainer {
    background-color: #24273a;
}

QStackedWidget#mainPages {
    background-color: #24273a;
    border: none;
}

QPushButton#settingsNav,
QPushButton#chatNav,
QPushButton#logsNav,
QPushButton#refresh {
    background-color: transparent;
    color: #a5adcb;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 24px;
}

QPushButton#settingsNav:hover,
QPushButton#chatNav:hover,
QPushButton#logsNav:hover,
QPushButton#refresh:hover {
    background-color: #363a4f;
    color: #cad3f5;
}

QPushButton#settingsNav:checked,
QPushButton#chatNav:checked,
QPushButton#logsNav:checked,
QPushButton#refresh:checked {
    background-color: #494d64;
    color: #cad3f5;
    border: 1px solid #8aadf4;
}

QLabel#logTitle,
QLabel#settingsTitle {
    color: #cad3f5;
    font-size: 20px;
    padding-left: 20px
}

QTextEdit#logViewer {
    background-color: #1e2030;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 12px;
    padding: 12px;
}

QComboBox#languageDropdown {
    combobox-popup: 0;
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    border-radius: 8px;
    padding: 10px 32px 10px 16px;
    font-size: 18px;
}

QComboBox#languageDropdown:hover,
QComboBox#languageDropdown:focus {
    border-color: #8aadf4;
}

QComboBox#languageDropdown::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0;
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView {
    background-color: #24273a;
    color: #cad3f5;
    border: 1px solid #494d64;
    selection-background-color: #494d64;
    selection-color: #cad3f5;
    padding: 6px;
    outline: none;
}

QComboBox#languageDropdown QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox#languageDropdown QAbstractItemView::item:hover,
QComboBox#languageDropdown QAbstractItemView::item:selected {
    background-color: #494d64;
    color: #cad3f5;
}

