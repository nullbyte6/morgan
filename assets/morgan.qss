QFrame#commandPalette {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 16px;
}

QPlainTextEdit#commandPaletteSearch {
    background-color: @surface_sunken;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 16px;
}

QListWidget#commandPaletteResults {
    background: transparent;
    color: @text;
    border: none;
    outline: none;
    font-size: 15px;
}

QListWidget#commandPaletteResults::item {
    padding: 8px 10px;
    border-radius: 8px;
}

QListWidget#commandPaletteResults::item:selected {
    background-color: @surface_selected;
    color: @text;
}

QListWidget#fileTagResults {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    padding: 4px;
    outline: none;
}

QListWidget#fileTagResults::item {
    padding: 4px 8px;
    border-radius: 6px;
}

QListWidget#fileTagResults::item:selected {
    background-color: @surface_selected;
    color: @accent;
}

QListWidget#commandPaletteResults::item:disabled,
QLabel#commandPaletteEmpty {
    color: @text_muted;
    background: transparent;
}

QListWidget#commandPaletteResults QScrollBar:vertical,
QListWidget#fileTagResults QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 0;
}

QListWidget#commandPaletteResults QScrollBar::handle:vertical,
QListWidget#fileTagResults QScrollBar::handle:vertical {
    background-color: @scrollbar_hover;
    border-radius: 3px;
    min-height: 24px;
}

QListWidget#commandPaletteResults QScrollBar::add-line:vertical,
QListWidget#commandPaletteResults QScrollBar::sub-line:vertical,
QListWidget#fileTagResults QScrollBar::add-line:vertical,
QListWidget#fileTagResults QScrollBar::sub-line:vertical {
    height: 0;
}

QListWidget#commandPaletteResults QScrollBar::add-page:vertical,
QListWidget#commandPaletteResults QScrollBar::sub-page:vertical {
    background: transparent;
}

QWidget#root,
QWidget#settingsPage {
    background-color: transparent;
    color: @text;
}

QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

QLabel#muted,
QLabel#status,
QLabel#activityTrail,
QLabel#subtitles {
    background: transparent;
    color: @text;
    font-size: 16px;
}

QLabel#activityTrail {
    color: @text_muted;
    font-size: 14px;
}


QToolTip {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    padding: 2px 6px;
    font-family: "Inter";
    font-size: 16px;
}

QWidget#mascotSubtitleBubble {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 24px;
    color: @text;
    font-size: 16px;
}

QFrame#inputFrame {
    background: transparent;
    border: 2px solid @border;
    border-radius: 24px;
}

QFrame#overlayCard {
    background-color: @surface_sunken;
    border: none;
    border-radius: 32px;
}

QLabel#responseTimer {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 17px;
    padding: 6px 12px;
}

QTextEdit {
    background: transparent;
    border: none;
    color: @text;
    font-size: 16px;
    selection-background-color: @selection;
}

QPushButton#attach,
QPushButton#send {
    border-radius: 20px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 16pt;
}

QPushButton#send {
    border-radius: 18px;
    background-color: @accent;
    color: @on_accent;
    border: none;
}

QPushButton#send[mic="true"] {
    font-size: 24pt;
}

QPushButton#attach {
    background-color: transparent;
    border: none;
    color: @text;
}

QPushButton#send:hover {
    background-color: @accent_hover;
    color: @on_accent;
}

QPushButton#attach:hover {
    background-color: transparent;
    color: @accent_hover;
}

QPushButton#send:pressed {
    background-color: @accent;
    color: @on_accent;
}

QPushButton#attach:pressed {
    background-color: transparent;
    color: @accent;
}

QPushButton#send:disabled {
    background-color: @surface_selected;
    color: @text;
}

QPushButton#attach:disabled {
    background-color: transparent;
    color: @text_disabled;
}

ToggleSwitch {
    qproperty-trackOff: @toggle_track_off;
    qproperty-trackOn: @toggle_track_on;
    qproperty-thumbColor: @toggle_thumb;
}

QMainWindow#assistantWindow {
    background-color: @surface_sunken;
}

QGraphicsView#globalZoomView,
QWidget#globalZoomViewport,
QWidget#windowContainer {
    background-color: transparent;
}

QPushButton#settingsNav,
QPushButton#editorNav,
QPushButton#terminalNav,
QPushButton#novaNav {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 10px;
    font-size: 32px;
}

QPushButton#logCopyNav,
QPushButton#logRemoveNav {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 6px;
    font-size: 14px;
    padding: 0;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
}

QPushButton#settingsNav:hover,
QPushButton#editorNav:hover,
QPushButton#terminalNav:hover,
QPushButton#novaNav:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#logCopyNav:hover,
QPushButton#logRemoveNav:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#logCopyNav[pinned="true"] {
    color: @accent;
}

QPushButton#logRemoveNav[armed="true"] {
    background-color: @error/30;
    color: @error;
}

QToolButton#directory {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 16px;
    color: @text_muted;
    padding: 4px;
}

QToolButton#directory:hover,
QToolButton#directory:pressed {
    background-color: @surface_raised;
    color: @text;
}

QComboBox#modelSelector {
    combobox-popup: 0;
    background-color: transparent;
    border: none;
    border-radius: 16px;
    color: transparent;
    padding: 0;
}

QComboBox#modelSelector:hover,
QComboBox#modelSelector:on {
    background-color: @surface_raised;
}

QLabel#languageDropdownArrow {
    background: transparent;
    color: @text_muted;
}

QComboBox#modelSelector:hover QLabel#languageDropdownArrow,
QComboBox#modelSelector:on QLabel#languageDropdownArrow {
    color: @text;
}

QToolButton#permissionSelector {
    background-color: transparent;
    border: none;
    border-radius: 16px;
    padding: 0;
}

QWidget#indicatorRow[resting="true"] QLabel#responseTimer,
QWidget#indicatorRow[resting="true"] QToolButton#directory {
    color: @text_muted/140;
}

QToolButton#permissionSelector:hover,
QToolButton#permissionSelector:pressed {
    background-color: @surface_raised;
}

QFrame#permissionOptions {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 16px;
}

QPushButton#permissionOption {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    color: @text_muted;
    padding: 4px 12px;
}

QPushButton#permissionOption:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#permissionOption:checked {
    background-color: @surface_selected;
    color: @text;
}

QComboBox#languageDropdown,
QComboBox#modelDropdown,
QComboBox#themeDropdown {
    combobox-popup: 0;
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    border-radius: 8px;
    padding: 10px 32px 10px 16px;
    font-size: 16px;
}

QComboBox#languageDropdown:hover,
QComboBox#modelDropdown:hover,
QComboBox#themeDropdown:hover,
QComboBox#languageDropdown:focus,
QComboBox#modelDropdown:focus,
QComboBox#themeDropdown:focus {
    border-color: @accent;
}

QLineEdit#contextLengthInput {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 16px;
}

QLineEdit#contextLengthInput:hover,
QLineEdit#contextLengthInput:focus {
    border-color: @accent;
}

QPushButton#ollamaButton {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    border-radius: 8px;
    padding: 0;
    font-size: 20px;
}

QPushButton#ollamaButton:hover,
QPushButton#ollamaButton:focus {
    border-color: @accent;
}

QPushButton#ollamaButton:pressed {
    background-color: @surface_selected;
}

QPushButton#ollamaButton:disabled {
    border-color: @border;
    background-color: @surface_sunken;
}

QPushButton#themesFolderButton {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 16px;
}

QPushButton#themesFolderButton:hover,
QPushButton#themesFolderButton:focus {
    border-color: @accent;
}

QPushButton#themesFolderButton:pressed {
    background-color: @accent;
    color: @on_accent;
}

QPushButton#removeMemoriesButton {
    background-color: @error/30;
    color: @error;
    border: 2px solid @error;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#removeMemoriesButton:hover,
QPushButton#removeMemoriesButton:focus {
    background-color: @error;
    color: @surface;
}

QComboBox#languageDropdown::drop-down,
QComboBox#modelDropdown::drop-down,
QComboBox#themeDropdown::drop-down,
QComboBox#modelSelector::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0;
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView,
QComboBox#modelDropdown QAbstractItemView,
QComboBox#themeDropdown QAbstractItemView,
QComboBox#modelSelector QAbstractItemView {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    selection-background-color: @selection;
    selection-color: @text;
    padding: 6px;
    outline: none;
}

QComboBox#languageDropdown QAbstractItemView::item,
QComboBox#modelDropdown QAbstractItemView::item,
QComboBox#themeDropdown QAbstractItemView::item,
QComboBox#modelSelector QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 24px;
}

QComboBox#languageDropdown QAbstractItemView,
QComboBox#modelDropdown QAbstractItemView,
QComboBox#themeDropdown QAbstractItemView {
    font-size: 16px;
}

QComboBox#modelSelector QAbstractItemView {
    font-size: 16px;
    border-radius: 12px;
}

QComboBoxPrivateContainer {
    background: transparent;
    border: none;
}

QComboBox#languageDropdown QAbstractItemView[opens="up"],
QComboBox#modelDropdown QAbstractItemView[opens="up"],
QComboBox#themeDropdown QAbstractItemView[opens="up"] {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QComboBox#languageDropdown QAbstractItemView[opens="down"],
QComboBox#modelDropdown QAbstractItemView[opens="down"],
QComboBox#themeDropdown QAbstractItemView[opens="down"] {
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QComboBox#languageDropdown QAbstractItemView,
QComboBox#modelDropdown QAbstractItemView,
QComboBox#themeDropdown QAbstractItemView {
    border-radius: 12px;
}

QComboBox#languageDropdown QAbstractItemView::item:hover,
QComboBox#modelDropdown QAbstractItemView::item:hover,
QComboBox#themeDropdown QAbstractItemView::item:hover,
QComboBox#modelSelector QAbstractItemView::item:hover,
QComboBox#languageDropdown QAbstractItemView::item:selected,
QComboBox#modelDropdown QAbstractItemView::item:selected,
QComboBox#themeDropdown QAbstractItemView::item:selected,
QComboBox#modelSelector QAbstractItemView::item:selected {
    background-color: @surface_selected;
    color: @text;
}

QScrollArea#chatScroll {
    background: transparent;
    border: none;
}

QScrollArea#chatScroll QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollArea#chatScroll QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QWidget#attachmentTray {
    background: transparent;
    border: none;
}

QFrame#attachmentChip {
    background-color: transparent;
    border: 2px solid @border;
    border-radius: 12px;
}

QFrame#attachmentChip:hover {
    background-color: @surface_raised;
    border-color: @border_strong;
}

QFrame#attachmentChip QLabel {
    background: transparent;
    border: none;
    color: @text;
    font-size: 13px;
}

QFrame#attachmentChip QLabel#attachmentDetail {
    font-size: 11px;
}

QPushButton#removeAttachment {
    background: transparent;
    color: @text;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    padding: 0;
}

QPushButton#removeAttachment:hover,
QPushButton#removeAttachment:pressed {
    background-color: @surface_raised;
    color: @text;
}

QWidget#editorPage {
    background-color: @surface;
    color: @text;
}

QPlainTextEdit#codeEditor,
QPlainTextEdit#diffWorkspaceEditor {
    background-color: @surface_sunken;
    color: @text;
    border: none;
    border-radius: 10px;
    selection-background-color: @selection;
    selection-color: @text;
}

QPlainTextEdit#codeEditor QScrollBar:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar:vertical {
    background-color: @surface_sunken;
    width: 12px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:vertical {
    background-color: @scrollbar;
    border-radius: 4px;
    min-height: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:vertical:hover,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:vertical:hover {
    background-color: @scrollbar_hover;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-line:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-line:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-page:vertical,
QPlainTextEdit#codeEditor QScrollBar::sub-page:vertical,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-page:vertical {
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar:horizontal {
    background-color: @surface_sunken;
    height: 10px;
    margin: 0;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:horizontal {
    background-color: @scrollbar;
    border-radius: 5px;
    min-width: 28px;
}

QPlainTextEdit#codeEditor QScrollBar::handle:horizontal:hover,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::handle:horizontal:hover {
    background-color: @scrollbar_hover;
}

QPlainTextEdit#codeEditor QScrollBar::add-line:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-line:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-line:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: transparent;
}

QPlainTextEdit#codeEditor QScrollBar::add-page:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::add-page:horizontal,
QPlainTextEdit#codeEditor QScrollBar::sub-page:horizontal,
QPlainTextEdit#diffWorkspaceEditor QScrollBar::sub-page:horizontal {
    background: transparent;
}

QWidget#editorPage QPushButton,
QWidget#terminalPage QPushButton {
    background-color: @surface_raised;
    color: @text;
    border: 2px solid @border;
    border-radius: 9px;
    padding: 8px 16px;
}

QWidget#editorPage QPushButton:hover,
QWidget#terminalPage QPushButton:hover {
    background-color: @surface_selected;
    border-color: @accent;
}

QWidget#editorPage QPushButton:pressed,
QWidget#terminalPage QPushButton:pressed {
    background-color: @accent;
    color: @on_accent;
}

QWidget#editorPage QPushButton:disabled,
QWidget#terminalPage QPushButton:disabled {
    background-color: @surface_raised;
    color: @text_disabled;
    border-color: @border;
}

QPlainTextEdit#terminalOutput {
    background-color: transparent;
    color: @terminal_foreground;
    border: none;
    selection-background-color: @selection;
}

QLabel#terminalStatus {
    color: @text_muted;
    background: transparent;
}

QFileDialog,
QMessageBox {
    background-color: @surface;
    color: @text;
}

QMessageBox QLabel {
    color: @text;
    background: transparent;
}

#assistantWorkspace {
    background-color: transparent;
}

#workspacePanel {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 12px;
}

#workspacePanel[active="true"] {
    border: 2px solid @accent;
}

#workspacePanelHeader {
    background: transparent;
    border: none;
}

#workspacePanelTitle {
    color: @text;
    font-size: 16px;
    border: none;
}

#workspacePanelClose {
    color: @text;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 18px;
}

#workspacePanelClose:hover {
    background-color: transparent;
    color: @error;
}

#workspacePanelPalette {
    color: @text_muted/153;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 18px;
    padding: 0;
}

#workspacePanelPalette:hover {
    background-color: transparent;
    color: @accent;
}

#workspaceDropPreview {
    background-color: @accent/72;
    border: 2px solid @accent/210;
    border-radius: 10px;
}

#workspacePanelContent,
#workspacePlaceholder {
    background: transparent;
    border: none;
}

#workspacePlaceholderLabel {
    color: @text_subtle;
    font-size: 13px;
    border: none;
}

#desktopFileDropIndicator {
    background-color: @surface/210;
    border: 2px solid @accent;
    border-radius: 10px;
}

#desktopFileDropIndicator[valid="false"] {
    border-color: @text_subtle;
}

#desktopFileDropIndicator QLabel {
    color: @text;
    background: transparent;
    border: none;
    font-size: 13px;
}

#workspaceFileViewer,
#fileViewerSource,
#fileViewerSource QAbstractScrollArea:viewport {
    color: @text;
    background-color: @surface;
    border: none;
    selection-background-color: @selection;
}

#fileViewerStatus,
#diffWorkspaceDirectory {
    color: @text_muted;
    border: none;
    font-size: 12px;
}

#workspaceFileViewer QPushButton,
#workspaceFileViewer QSpinBox,
#workspaceFileViewer QLineEdit {
    color: @text;
    background-color: @surface_raised;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 3px 6px;
    min-width: 0;
}

#workspaceFileViewer QPushButton:hover {
    border-color: @accent;
}

#responseView,
#responseDocument,
#responseDocument QAbstractScrollArea:viewport {
    color: @text;
    background-color: @surface;
    border: none;
}

#responseDocument QScrollBar:vertical,
#responseDocument QScrollBar:horizontal {
    background: @surface;
    border: none;
}

QSplitter#workspaceSplitter::handle {
    background-color: transparent;
}

QSplitter#workspaceSplitter::handle:hover {
    background-color: @accent;
}

QPushButton#privacyIndicator {
    background-color: transparent;
    border: none;
    border-radius: 16px;
    padding: 0;
}

QToolButton#branchIndicator {
    color: @git_branch;
    background-color: @git_branch/20;
    border: 2px solid @git_branch/77~surface;
    border-radius: 16px;
    padding: 4px 10px;
}

QPushButton#privacyIndicator:hover {
    background-color: @surface_raised;
}

QWidget#mainWorkspaceContent,
QWidget#taskProgressHost {
    background: transparent;
}

QFrame#taskProgressPill {
    background-color: @surface_raised;
    border: 2px solid @border;
    border-radius: 24px;
    min-width: 0;
    max-width: 440px;
}

QLabel#taskProgressTitle {
    background: transparent;
    color: @text;
    border: none;
    font-size: 16px;
}

QLabel#taskProgressStep,
QLabel#taskProgressSubtitle {
    background: transparent;
    color: @text_secondary;
    border: none;
    font-size: 16px;
}

QProgressBar#taskProgressBar {
    background-color: @surface;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#taskProgressBar::chunk {
    background-color: @accent;
    border-radius: 4px;
}

QProgressBar#taskProgressBar[state="finished"]::chunk {
    background-color: @success;
}

QProgressBar#taskProgressBar[state="waiting"]::chunk,
QProgressBar#taskProgressBar[state="stopped"]::chunk {
    background-color: @warning;
}

QProgressBar#taskProgressBar[state="error"]::chunk {
    background-color: @error;
}

QPushButton#taskProgressClose {
    background: transparent;
    color: @text_muted;
    border: none;
    border-radius: 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
    font-size: 20px;
}

QPushButton#taskProgressClose:hover,
QPushButton#taskProgressClose:focus {
    background-color: transparent;
    color: @text;
}

QPushButton#taskProgressClose:pressed {
    color: @error;
}

QFrame#logMessageCard {
    background-color: @surface_sunken;
    border: 2px solid @border;
    border-radius: 12px;
}

QFrame#logMessageCard[role="assistant"] {
    background-color: @surface;
}

QFrame#logMessageCard[role="system"] {
    background-color: @surface_raised;
    border-color: @border_strong;
}

QLabel#logMessageAuthor {
    color: @accent;
    font-size: 16px;
    background: transparent;
    border: none;
}

QLabel#logMessageTime {
    color: @text_muted;
    font-size: 16px;
    background: transparent;
    border: none;
}

QTextBrowser#logMessageBody {
    background: transparent;
    color: @text;
    border: none;
    padding: 0;
    font-size: 16px;
    selection-background-color: @selection;
    selection-color: @text;
}

QTextBrowser#logMessageBody QScrollBar {
    width: 0;
    height: 0;
}

QWidget#terminalPage {
    background-color: transparent;
}

QPlainTextEdit#terminalOutput QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical {
    background: @scrollbar;
    min-height: 24px;
    border-radius: 3px;
}

QPlainTextEdit#terminalOutput QScrollBar::handle:vertical:hover {
    background: @scrollbar_hover;
}

QPlainTextEdit#terminalOutput QScrollBar::add-line:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QPlainTextEdit#terminalOutput QScrollBar::add-page:vertical,
QPlainTextEdit#terminalOutput QScrollBar::sub-page:vertical {
    background: transparent;
}

QMenu#terminalMenu {
    background-color: @surface;
    color: @text;
    border: 2px solid @border;
    padding: 4px;
}

QMenu#terminalMenu::item {
    padding: 6px 18px;
}

QMenu#terminalMenu::item:selected {
    background-color: @surface_selected;
}

QMenu#terminalMenu::item:disabled {
    color: @text_disabled;
}

QWidget#novaCalendar,
QWidget#novaWeekHeader,
QWidget#novaWeekHours,
QWidget#novaMonthGrid,
QWidget#novaYearGrid,
QWidget#novaMiniMonth {
    background: transparent;
}

QLabel#novaCalendarTitle {
    color: @text;
    font-size: 22px;
    background: transparent;
}

QPushButton#novaArrow {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 10px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 18px;
    padding: 0;
}

QPushButton#novaArrow:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#novaTodayButton,
QPushButton#novaSegment {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 14px;
}

QPushButton#novaTodayButton {
    border-color: @border;
}

QPushButton#novaTodayButton:hover,
QPushButton#novaSegment:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#novaSegment:checked {
    background-color: @surface_selected;
    color: @text;
}

QFrame#novaFlagTrack {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 16px;
}

QPushButton#novaFlagOption {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 12px;
    color: @text_muted;
    padding: 4px 12px;
    font-size: 14px;
}

QPushButton#novaFlagOption[flag="green"],
QPushButton#novaFlagOption[flag="yellow"],
QPushButton#novaFlagOption[flag="red"],
QPushButton#novaSegment[glyph="true"] {
    font-family: "JetBrainsMonoNL NFM";
}

QPushButton#novaFlagOption:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#novaFlagOption:checked {
    background-color: @surface_selected;
    color: @text;
}

QPushButton#novaFlagOption[flag="green"]:checked {
    background-color: @success;
    border: 2px solid transparent;
    border-radius: 12px;
    color: @on_accent;
}

QPushButton#novaFlagOption[flag="yellow"]:checked {
    background-color: @warning;
    border: 2px solid transparent;
    border-radius: 12px;
    color: @on_accent;
}

QPushButton#novaFlagOption[flag="red"]:checked {
    background-color: @error;
    border: 2px solid transparent;
    border-radius: 12px;
    color: @on_accent;
}

QScrollArea#novaScroll {
    background: transparent;
    border: none;
}

QScrollArea#novaScroll QScrollBar:vertical {
    background: transparent;
    width: 0px;
    margin: 0;
}

QScrollArea#novaScroll QScrollBar:horizontal {
    background: transparent;
    height: 0px;
    margin: 0;
}

QWidget#novaView,
QWidget#novaSidebar,
QWidget#novaEntryList,
QWidget#novaEntryBody,
QWidget#novaWelcome {
    background: transparent;
}

QFrame#novaDivider {
    background-color: @border;
    border: none;
}

QPushButton#novaStar {
    background-color: transparent;
    color: @accent;
    border: 2px solid transparent;
    border-radius: 12px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 28px;
    padding: 0;
}

QPushButton#novaStar:hover {
    background-color: @surface_raised;
    color: @accent_hover;
}

QLabel#novaTitle {
    color: @text;
    font-size: 24px;
    background: transparent;
}

QLabel#novaTagline {
    color: @text_muted;
    font-size: 14px;
    background: transparent;
}

QPushButton#novaAdd {
    background-color: @accent;
    color: @on_accent;
    border: 2px solid @border;
    border-radius: 21px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 18px;
    padding: 0;
}

QPushButton#novaAdd:hover {
    background-color: @accent_hover;
}

QLabel#novaGroup {
    color: @text_subtle;
    font-size: 13px;
    background: transparent;
    padding: 8px 2px 0 2px;
}

QFrame#novaRow {
    background-color: transparent;
    border: 2px solid @border;
    border-radius: 12px;
}

QFrame#novaRow:hover {
    background-color: @surface_raised;
    border-color: @border_strong;
}

QLabel#novaRowTitle {
    color: @text;
    font-size: 16px;
    background: transparent;
    border: none;
}

QFrame#novaRow[completed="true"] QLabel#novaRowTitle {
    color: @text_subtle;
}

QLabel#novaRowNotes {
    color: @text_muted;
    font-size: 14px;
    background: transparent;
    border: none;
}

QLabel#novaRowCaption {
    color: @text_subtle;
    font-size: 13px;
    background: transparent;
    border: none;
}

QFrame#novaRow[overdue="true"] QLabel#novaRowCaption {
    color: @error;
}

QPushButton#novaRowEdit {
    color: @text_subtle;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 15px;
    padding: 0;
}

QPushButton#novaRowEdit:hover {
    background-color: @surface_selected;
    color: @accent;
}

QLabel#novaRowMarker {
    color: @accent;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 20px;
    background: transparent;
    border: none;
}

QLabel#novaRowFlag {
    font-family: "JetBrainsMonoNL NFM";
    font-size: 17px;
    background: transparent;
    border: none;
}

QLabel#novaRowFlag[flag="green"] {
    color: @success;
}

QLabel#novaRowFlag[flag="yellow"] {
    color: @warning;
}

QLabel#novaRowFlag[flag="red"] {
    color: @error;
}

QLabel#novaWelcomeMark {
    color: @accent;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 44px;
    background: transparent;
}

QLabel#novaWelcomeTitle {
    color: @text;
    font-size: 18px;
    background: transparent;
}

QLabel#novaWelcomeText {
    color: @text_muted;
    font-size: 14px;
    background: transparent;
}

QWidget#novaScrim,
QWidget#choiceScrim {
    background-color: @surface/205;
}

QFrame#novaCard,
QFrame#novaPicker {
    background-color: @surface;
    border: 2px solid @border;
    border-radius: 16px;
}

QFrame#novaPicker {
    border-radius: 14px;
}

QLabel#novaDialogTitle {
    color: @text;
    font-size: 20px;
    background: transparent;
    border: none;
}

QScrollArea#choiceScroll,
QWidget#choiceGrid {
    background: transparent;
    border: none;
}

QScrollArea#choiceScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollArea#choiceScroll QScrollBar::handle:vertical {
    background-color: @scrollbar_hover;
    border-radius: 3px;
    min-height: 24px;
}

QScrollArea#choiceScroll QScrollBar::add-line:vertical,
QScrollArea#choiceScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#choiceScroll QScrollBar::add-page:vertical,
QScrollArea#choiceScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

QLabel#choiceMessage {
    color: @text_muted;
    font-size: 15px;
    background: transparent;
    border: none;
}

QLabel#novaFieldLabel {
    color: @text_muted;
    font-size: 13px;
    background: transparent;
    border: none;
}

QLabel#novaError {
    color: @error;
    font-size: 13px;
    background: transparent;
    border: none;
}

QLineEdit#novaInput,
QPlainTextEdit#novaInput,
QPushButton#novaDateButton {
    background-color: @surface_sunken;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 15px;
    selection-background-color: @selection;
    selection-color: @text;
}

QPushButton#novaDateButton {
    text-align: left;
}

QLineEdit#novaInput:hover,
QPlainTextEdit#novaInput:hover,
QPushButton#novaDateButton:hover {
    border-color: @border_strong;
}

QLineEdit#novaInput:focus,
QPlainTextEdit#novaInput:focus {
    border-color: @accent;
}

QPushButton#novaPrimaryButton,
QPushButton#novaSecondaryButton,
QPushButton#novaDangerButton {
    border-radius: 10px;
    padding: 8px 18px;
    font-size: 15px;
    border: 2px solid transparent;
}

QPushButton#novaPrimaryButton {
    background-color: @accent;
    color: @on_accent;
}

QPushButton#novaPrimaryButton:hover {
    background-color: @accent_hover;
}

QPushButton#novaPrimaryButton:disabled {
    background-color: @surface_selected;
    color: @text_disabled;
}

QPushButton#novaSecondaryButton {
    background-color: transparent;
    color: @text;
    border-color: @border;
}

QPushButton#novaSecondaryButton:hover {
    background-color: @surface_raised;
}

QPushButton#novaDangerButton {
    background-color: transparent;
    color: @error;
}

QPushButton#novaDangerButton:hover {
    background-color: @error/30;
}

QWidget#novaNavigation,
QWidget#novaTray {
    background: transparent;
}

QPushButton#novaNav {
    color: @accent;
}

QPushButton#novaNav:hover {
    color: @accent_hover;
}

QPushButton#novaNav[expanded="true"] {
    background-color: @surface_selected;
}

QWidget#novaDiary,
QWidget#novaSearch,
QWidget#novaMemories,
QWidget#healthView,
QWidget#songView {
    background: transparent;
}

QLabel#songEmpty {
    color: @text_muted;
    font-size: 15px;
    background: transparent;
    padding: 28px;
}

QLabel#songCover {
    background-color: @surface_raised;
    color: @text_subtle;
    border-radius: 16px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 64px;
}

QLabel#songTitle {
    color: @text;
    font-size: 22px;
    background: transparent;
}

QLabel#songArtist {
    color: @text_secondary;
    font-size: 16px;
    background: transparent;
}

QLabel#songAlbum {
    color: @text_subtle;
    font-size: 14px;
    background: transparent;
}

QLabel#songTime {
    color: @text_muted;
    font-size: 13px;
    background: transparent;
}

QLabel#songSummary {
    color: @text_muted;
    font-size: 16px;
    background: transparent;
}

QSlider#songSeek {
    background: transparent;
    min-height: 18px;
}

QSlider#songSeek::groove:horizontal,
QSlider#songSeek::add-page:horizontal {
    height: 6px;
    background-color: @surface_selected;
    border-radius: 3px;
}

QSlider#songSeek::sub-page:horizontal {
    height: 6px;
    background-color: @accent;
    border-radius: 3px;
}

QSlider#songSeek::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -4px 0;
    background-color: @text;
    border-radius: 7px;
}

QSlider#songSeek:disabled::handle:horizontal {
    background-color: transparent;
}

QPushButton#songTransport {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid transparent;
    border-radius: 22px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 22px;
    padding: 0;
}

QPushButton#songTransport:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#songAction {
    background-color: transparent;
    color: @text_muted;
    border: 2px solid @border;
    border-radius: 18px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 18px;
    padding: 0;
}

QPushButton#songAction:hover {
    background-color: @surface_raised;
    color: @text;
}

QPushButton#songAction:disabled {
    color: @text_disabled;
}

QPushButton#songPlay {
    background-color: @accent;
    color: @on_accent;
    border: 2px solid @border;
    border-radius: 28px;
    font-family: "JetBrainsMonoNL NFM";
    font-size: 26px;
    padding: 0;
}

QPushButton#songPlay:hover {
    background-color: @accent_hover;
}

QLabel#novaDiaryDay {
    color: @text;
    font-size: 18px;
    background: transparent;
}

QLabel#healthStatus {
    font-family: "JetBrainsMonoNL NFM";
    font-size: 18px;
    background: transparent;
}

QLabel#healthStatus[status="ok"] {
    color: @success;
}

QLabel#healthStatus[status="warning"] {
    color: @warning;
}

QLabel#healthStatus[status="error"] {
    color: @error;
}

QLabel#novaDiaryNote {
    color: @text_muted;
    font-size: 14px;
    background: transparent;
    padding: 24px 8px;
}
